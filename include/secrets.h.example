/**
 * Template for include/secrets.h (gitignored, not checked in).
 *
 * Copy this file to include/secrets.h and fill in your own deployment's
 * real values - config.h #includes secrets.h and won't compile without it:
 *
 *   cp include/secrets.h.example include/secrets.h
 */

#ifndef SECRETS_H
#define SECRETS_H

#define API_URL             "http://your-server.example.com:8081/your-endpoint"

// Optional: HTTP Basic Auth credentials for API_URL.
// cellular_http.c only sends the Authorization header when both are defined.
//#define API_AUTH_USER       "your-username"
//#define API_AUTH_PASS       "your-password"

#define MQTT_BROKER_HOST    "your-broker.example.com"
#define MQTT_BROKER_PORT    1883
#define MQTT_BROKER_URI     "mqtt://your-broker.example.com:1883"

// Optional: MQTT username/password auth for MQTT_BROKER_*, both the WiFi
// (mqtt_report.c) and cellular (AT+CMQTT*, cellular.c) paths. Both send the
// credentials only when both are defined.
//#define MQTT_AUTH_USER       "your-username"
//#define MQTT_AUTH_PASS       "your-password"

#define CELLULAR_APN        "your-carrier-apn"

#endif // SECRETS_H
